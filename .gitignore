# ConflictLab .gitignore

# Python cache
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python

# Virtual environments
.venv/
venv/
env/
ENV/

# Distribution / packaging
dist/
build/
*.egg-info/
*.egg

# Testing
.pytest_cache/
.coverage
htmlcov/

# IDE
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# Jupyter
.ipynb_checkpoints/

# Logs
*.log

# Local environment / secrets
.env
.env.local
.env.*
!.env.example

# Hostinger Wave 1 deployment secrets — never commit live credentials
deploy/wave1-hostinger/config.php
deploy/wave1-hostinger/config.local.php
deploy/wave1-hostinger/.env
deploy/wave1-hostinger/.env.*
!deploy/wave1-hostinger/.env.example
